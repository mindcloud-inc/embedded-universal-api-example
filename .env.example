# Nothing here is required to start the app: run `npm run dev` and paste your
# API key into the setup page, which writes MINDCLOUD_API_KEY to .env.local.

# Your MindCloud API key (Full Access). Server-side only, never sent to the browser.
MINDCLOUD_API_KEY=

# Advanced: only change these when pointing at a non-production MindCloud.
MINDCLOUD_API_BASE_URL=https://connect.mindcloud.co
NEXT_PUBLIC_MINDCLOUD_EMBEDDED_BASE_URL=https://embedded.mindcloud.co
