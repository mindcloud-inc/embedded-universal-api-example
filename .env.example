# Required. Create one at https://app.mindcloud.co/user/api-keys with Full Access
# (minting end-user tokens requires it). Server-side only — never exposed to the browser.
MINDCLOUD_API_KEY=

# The demo end user this app creates in your MindCloud account on first run.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_NAME=Demo User

# Advanced: only change these when pointing at a non-production MindCloud.
MINDCLOUD_API_BASE_URL=https://connect.mindcloud.co
NEXT_PUBLIC_MINDCLOUD_EMBEDDED_BASE_URL=https://embedded.mindcloud.co
